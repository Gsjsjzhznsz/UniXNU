+/*
+ * 0268: the IOVA of S for the display (mapped on first use, kept while it is swapped), or 0. An entry is
+ * only evicted when its surface is neither held nor the one being swapped, so the pipe never reads a
+ * page that was given back. Present path only.
+ */
+uint32_t
+AppleCLCD::scanoutIova(SweetSurface *s)
+{
+	static uint64_t pages[(16u << 20) / 4096];
+	fScanoutClock++;
+	for (unsigned i = 0; i < SWEET_SCANOUT_MAPS; i++) {
+		if (fScanoutMaps[i].s == s) {
+			fScanoutMaps[i].used = fScanoutClock;
+			return fScanoutMaps[i].iova;
+		}
+	}
+	int slot = -1;
+	for (unsigned i = 0; i < SWEET_SCANOUT_MAPS; i++) {
+		if (fScanoutMaps[i].s == NULL) {
+			slot = (int)i;
+			break;
+		}
+		bool held = false;
+		for (uint32_t k = 0; k < fZcCount; k++) {
+			held = held || fZcHeld[k] == fScanoutMaps[i].s;
+		}
+		if (!held && (slot < 0 || fScanoutMaps[i].used < fScanoutMaps[slot].used)) {
+			slot = (int)i;
+		}
+	}
+	if (slot < 0) {
+		return 0;
+	}
+	if (fScanoutMaps[slot].s != NULL) {
+		sweet_scanout_unmap(fScanoutMaps[slot].iova, fScanoutMaps[slot].pages);
+		fScanoutMaps[slot].s->memory->complete();
+		fScanoutMaps[slot].s->release();
+		fScanoutMaps[slot].s = NULL;
+	}
+	const uint64_t len = s->memory->getLength();
+	/* pages[] holds 4096 entries: compare BYTES against entries x 4096, not sizeof(pages) (32 KiB) */
+	if (len == 0 || len > (uint64_t)(sizeof(pages) / sizeof(pages[0])) * 4096ull) {
+		return 0;
+	}
+	if (s->memory->prepare() != kIOReturnSuccess) {
+		return 0;
+	}
+	const uint32_t n = (uint32_t)((len + 4095) / 4096);
+	bool ok = true;
+	for (uint32_t i = 0; i < n && ok; i++) {
+		IOByteCount seg = 0;
+		const addr64_t pa = s->memory->getPhysicalSegment((IOByteCount)i * 4096, &seg, kIOMemoryMapperNone);
+		ok = pa != 0 && (pa & 0xfff) == 0;
+		pages[i] = pa;
+	}
+	const uint32_t iova = ok ? sweet_scanout_map(pages, n) : 0;
+	if (iova == 0) {
+		s->memory->complete();
+		return 0;
+	}
+	/* the prepare() stays outstanding while the mapping is in the cache; eviction completes it */
+	s->retain();
+	fScanoutMaps[slot].s = s;
+	fScanoutMaps[slot].iova = iova;
+	fScanoutMaps[slot].pages = n;
+	fScanoutMaps[slot].used = fScanoutClock;
+	IOLog("SWEET FB: scanout maps surface %u (%ux%u, %u pages) at iova %#x\n", s->id, s->width, s->height, n, iova);
+	return iova;
+}
+
+/*
+ * 0268: one frame the pipe takes as it is: one layer showing the whole canvas from a BGRA surface of
+ * exactly that size, display on. True when the pipe has it (the surface is held until a later flush);
+ * else the frame is copied as before.
+ */
+bool
+AppleCLCD::scanoutPresent(SweetSurface *s, uint32_t id, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	if (s == NULL || s->memory == NULL) {
+		return zcDecline(20, "scanout: no surface memory", id);
+	}
+	if (!fScanoutOn) {
+		if (fScanoutTried) {
+			return zcDecline(21, "scanout: the display stream is not the ABL's panel setup (CPU copy)", id);
+		}
+		fScanoutTried = true;
+		if (sweet_scanout_init(fPhys, fRowBytes, fWidth, fHeight) != 0) {
+			return zcDecline(21, "scanout: the display stream is not the ABL's panel setup (CPU copy)", id);
+		}
+		fScanoutOn = true;
+		IOLog("SWEET FB: scanout on: the display reads the frames itself, no CPU copy\n");
+	}
+	if (sx != 0 || sy != 0 || dx != 0 || dy != 0 || w != (int32_t)fLogicalW || h != (int32_t)fLogicalH ||
+	    s->width != fLogicalW || s->height != fLogicalH || s->pixelFormat != SWEET_FB_FORMAT_BGRA ||
+	    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->planeCount > 1 ||
+	    s->bytesPerRow < s->width * 4 || s->bytesPerRow > 0xffff || (s->offset & 0xf) != 0) {
+		return zcDecline(22, "scanout: not a lone full-canvas BGRA surface", id);
+	}
+	const uint32_t dstW = (uint32_t)((uint64_t)fLogicalW * fScaleXNum / fScaleXDen);
+	const uint32_t dstH = (uint32_t)((uint64_t)fLogicalH * fScaleYNum / fScaleYDen);
+	if (fScale == 0 || dstW == 0 || dstH == 0 || dstW > fWidth || dstH > fHeight) {
+		return zcDecline(23, "scanout: destination rectangle outside the panel", id);
+	}
+	const uint32_t iova = scanoutIova(s);
+	if (iova == 0) {
+		return zcDecline(24, "scanout: no free IOVA slot", id);
+	}
+	/*
+	 * The GPU wrote the surface (it bypasses the CPU cache); a CPU-drawn frame keeps dirty lines in
+	 * the write-back mapping, so clean it to memory for the pipe.
+	 */
+	uintptr_t kva = s->kernelAddress();
+	if (kva != 0) {
+		sweet_dma_sync_va((const void *)(kva + s->offset), (size_t)((uint64_t)s->bytesPerRow * fLogicalH));
+	}
+	struct sweet_scan_frame f;
+	f.iova = iova + s->offset;
+	f.stride = s->bytesPerRow;
+	f.src_x = 0;
+	f.src_y = 0;
+	f.src_w = fLogicalW;
+	f.src_h = fLogicalH;
+	f.dst_x = (uint32_t)(fPadX < 0 ? 0 : fPadX);
+	f.dst_y = (uint32_t)(fPadY < 0 ? 0 : fPadY);
+	f.dst_w = dstW;
+	f.dst_h = dstH;
+	if (sweet_scanout_show(&f) != 0) {
+		return zcDecline(25, "scanout: the pipe refused the frame (earlier flush not taken)", id);
+	}
+	/* show() waited for the earlier flush: let the hold of the frame before it go, then hold this one */
+	zcPoll();
+	if (fZcCount >= 4) {
+		waitLatch();
+		zcPoll(true);
+	}
+	if (fZcCount >= 4) {
+		return zcDecline(26, "scanout: four earlier frames still waiting for their latch", id);
+	}
+	sweet_hold(s, true);
+	fZcHeld[fZcCount++] = s;        /* keeps the reference sweet_surface_copy gave */
+	fZcFront = true;
+	fLastFlush = (1u << 0) | SWEET_MDP_CTL_BIT;     /* VIG0 (sweet_mdp_pipes[0].flush) + the CTL itself */
+	__atomic_store_n(&fShotId, id, __ATOMIC_RELEASE);
+	__atomic_store_n(&fSwapScanID, fCurSwapID, __ATOMIC_RELEASE);
+	if (++fScanoutFrames == 1) {
+		IOLog("SWEET FB: first GPU scanout: surface %u at iova %#x (stride %u), %ux%u -> %ux%u at %u,%u, no copy\n",
+		    id, iova, s->bytesPerRow, fLogicalW, fLogicalH, dstW, dstH, f.dst_x, f.dst_y);
+	}
+	return true;
+}
