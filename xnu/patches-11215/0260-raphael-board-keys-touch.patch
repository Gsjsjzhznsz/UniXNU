+/* Plain register write: FIFO message (at most 3 bytes) or a bit-banged write. */
+static int
+touch_write(uint8_t addr, const uint8_t *buf, unsigned n)
+{
+	if (st.bitbang) {
+		return bb_xfer(addr, buf, n, NULL, 0);
+	}
+	return touch_msg(addr, buf, n, NULL, 0, false);
+}
+
+static int
+touch_nor_write(uint16_t reg, uint8_t val)
+{
+	const uint8_t msg[3] = {(uint8_t)(reg >> 8), (uint8_t)reg, val};
+	return touch_write(NOR_ADDR, msg, sizeof(msg));
+}
+
+/*
+ * GT9886 Normandy frame, vendor goodix_touch_handler: [0] status, [1] count
+ * in the low nibble, 8 bytes per point from [2] (id low nibble, x LE16,
+ * y LE16, width, ...), then key and checksum; the 8-bit sum over
+ * count * 8 + 4 bytes is zero. Pen records (>= 0x80) are dropped. flip
+ * bit 0 mirrors x and bit 1 mirrors y (DT goodix,x2x / goodix,y2y).
+ * No I/O: buf holds at least count * 8 + 4 bytes.
+ */
+static int
+touch_nor_parse(const uint8_t *buf, unsigned n, uint32_t *maskp, int *x, int *y)
+{
+	uint8_t sum = 0;
+	uint32_t mask = 0;
+	unsigned max_x = tb->w - 1u, max_y = tb->h - 1u;
+	if (n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n * NOR_POINT_LEN + 4u; ++i) {
+		sum = (uint8_t)(sum + buf[i]);
+	}
+	if (sum) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2u + i * NOR_POINT_LEN;
+		if (p[0] & 0x80u) {
+			continue;
+		}
+		unsigned id = p[0] & 15u;
+		unsigned px = p[1] | ((unsigned)p[2] << 8);
+		unsigned py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > max_x || py > max_y) {
+			return EIO;
+		}
+		if (st.flip & 1u) {
+			px = max_x - px;
+		}
+		if (st.flip & 2u) {
+			py = max_y - py;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	*maskp = mask;
+	return 0;
+}
+
+/*
+ * Vendor goodix_set_i2c_doze_mode(false): request 0xaa, wait for 0xbb.
+ * Doze is never re-enabled: this driver polls instead of waiting for the
+ * IRQ, so the IC has to stay awake between reads.
+ */
+static int
+touch_nor_doze_off(void)
+{
+	uint8_t v = 0;
+	int err = touch_nor_write(NOR_DOZE_CTRL, 0xaa);
+	touch_wait(1);
+	for (unsigned i = 0; i < 9u; ++i) {
+		err = touch_read(NOR_ADDR, NOR_DOZE_STAT, true, &v, 1);
+		if (!err && v == 0xbbu) {
+			return 0;
+		}
+		if (err || v != 0xaau) {
+			(void)touch_nor_write(NOR_DOZE_CTRL, 0xaa);
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: normandy doze-off not confirmed (stat=%#x err=%d)\n", v, err);
+	return err ? err : ETIMEDOUT;
+}
+
+/*
+ * Vendor goodix_read_version: the 72-byte version block sums to zero and
+ * holds PID "9886" at 0x4535, VID at 0x453d and the sensor ID at 0x4541.
+ */
+static int
+touch_nor_probe(void)
+{
+	uint8_t v[NOR_VERSION_LEN];
+	uint8_t sum = 0;
+	memset(v, 0xa5, sizeof(v));
+	int err = touch_read(NOR_ADDR, NOR_VERSION_REG, true, v, sizeof(v));
+	if (!err) {
+		for (unsigned off = 0; off < sizeof(v); off += 16) {
+			char line[49];
+			unsigned len = sizeof(v) - off < 16u ? (unsigned)sizeof(v) - off : 16u;
+			line[0] = '\0';
+			for (unsigned j = 0; j < len; ++j) {
+				(void)snprintf(line + j * 3u, 4, "%02x ", v[off + j]);
+			}
+			printf("SWEET TOUCH: probe raw %#x: %s\n", NOR_VERSION_REG + off, line);
+		}
+		for (unsigned i = 0; i < sizeof(v); ++i) {
+			sum = (uint8_t)(sum + v[i]);
+		}
+	}
+	const uint8_t *pid = v + NOR_PID_OFF, *vid = v + NOR_VID_OFF;
+	printf("SWEET TOUCH: normandy version err=%d sum=%#x pid=%02x%02x%02x%02x vid=%02x%02x%02x%02x sensor=%u\n",
+	    err, sum, pid[0], pid[1], pid[2], pid[3], vid[0], vid[1], vid[2], vid[3],
+	    v[NOR_SENSOR_OFF] & 15u);
+	if (err) {
+		return err;
+	}
+	if (sum || pid[0] != '9' || pid[1] != '8' || pid[2] != '8' || pid[3] != '6') {
+		return ENODEV;
+	}
+	st.sensor = v[NOR_SENSOR_OFF] & 15u;
+	return 0;
+}
+
+static int
+touch_goodix_nor(void)
+{
+	uint8_t buf[NOR_FIRST_LEN + (TOUCH_MAX - 1u) * NOR_POINT_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(NOR_ADDR, NOR_EVENT_REG, true, buf, NOR_FIRST_LEN);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		err = EIO;
+	} else if (n > 1u) {
+		err = touch_read(NOR_ADDR, NOR_EVENT_REG + NOR_FIRST_LEN, true,
+		    buf + NOR_FIRST_LEN, (n - 1u) * NOR_POINT_LEN);
+	}
+	if (!err) {
+		err = touch_nor_parse(buf, n, &mask, x, y);
+	}
+	/* Like the vendor handler, clear the status for every touch frame seen. */
+	int ack = touch_nor_write(NOR_EVENT_REG, 0);
+	if (!err) {
+		err = ack;
+	}
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
+
+/* raphael: power the GT9886 through its load switches, reset it, leave doze. */
+static bool
+touch_raphael_start(void)
+{
+	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd=%#x avdd=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(RAPHAEL_VDD_GPIO)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(RAPHAEL_AVDD_GPIO)));
+	/*
+	 * Vendor goodix_ts_power_init/power_on/gpio_setup: IRQ an input with
+	 * pull-up, reset held low while the load switches turn on. 16 mA and
+	 * pull-up follow the DT tp_active state.
+	 */
+	touch_gpio(tb->irq, 0, 3, 7, false, false);
+	touch_gpio(tb->rst, 0, 3, 7, true, false);
+	touch_gpio(RAPHAEL_VDD_GPIO, 0, 0, 0, true, true);
+	touch_gpio(RAPHAEL_AVDD_GPIO, 0, 0, 0, true, true);
+	touch_wait(300); /* DT goodix,power-on-delay-us = 300000 */
+	if (st.bitbang) {
+		touch_gpio(tb->sda, 0, 0, 0, false, false); /* GPIO function, released */
+		touch_gpio(tb->scl, 0, 0, 0, false, false);
+	} else {
+		touch_gpio(tb->sda, tb->mux, 0, 0, false, false); /* qup19, 2 mA, no pull */
+		touch_gpio(tb->scl, tb->mux, 0, 0, false, false);
+	}
+	/* Vendor goodix_hw_reset (Normandy): low 2 ms, high, then wait. */
+	touch_gpio(tb->rst, 0, 3, 7, true, false);
+	touch_wait(2);
+	touch_gpio(tb->rst, 0, 3, 7, true, true);
+	touch_wait(300);
+	st.probing = true;
+	int derr = touch_nor_doze_off();
+	int perr = touch_nor_probe();
+	st.probing = false;
+	if (st.dead || perr) {
+		printf("SWEET TOUCH: no GT9886 Normandy at %#x (doze=%d probe=%d dead=%d); stopping\n",
+		    NOR_ADDR, derr, perr, st.dead);
+		return false;
+	}
+	/* DT sensor0 carries goodix,x2x and goodix,y2y; sensor1 does not. */
+	int flip = -1;
+	(void)PE_parse_boot_argn("sweettouchflip", &flip, sizeof(flip));
+	st.flip = flip >= 0 ? (unsigned)flip & 3u : (st.sensor == 0 ? 3u : 0u);
+	printf("SWEET TOUCH: GT9886 sensor=%u flip=%u%s\n", st.sensor, st.flip,
+	    flip >= 0 ? " (sweettouchflip)" : "");
+	st.kind = TOUCH_GT9886;
+	return true;
+}
