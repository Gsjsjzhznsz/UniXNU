raphael (Redmi K20 Pro, SM8150): wall clock from the PM8150 RTC and the battery from the PM8150B fuel gauge.

- RTC: the Poco F1 code of 0245 (raw RTC seconds plus an offset kept in the RTC alarm's data registers while the
  alarm is disabled; IORTC published so iOS takes its time from it at boot, setGMTTimeOfDay stores the offset) now
  also runs on raphael. PM8150 has the same pm8941-layout RTC at SID 0 0x6000/0x6100 as PM8998. The only PMIC
  writes allowed on raphael are the four alarm data bytes 0x6140-0x6143.
- SPMI reads on raphael: PM8150 RTC 0x60/0x61; PM8150B (SID 2) SMB5 charger 0x10/0x11/0x12/0x13/0x15/0x16 and FG
  gen4 BATT_SOC 0x40 / BATT_INFO 0x41 (status registers only, no FG SRAM access). The SM8150 PMIC arbiter is the
  same v5 block at the same addresses as the Poco F1's.
- SweetBattery on raphael (on by default; sweetbattery=0 turns it off): monotonic SOC 0x4009 (gen3 scaling),
  VBATT 0x41a0 (122.07 or 194.637 uV/bit, whichever is plausible), IBATT 0x41a2, USBIN plug-in 0x1310 bit 4,
  charge state 0x1006 bits 2:0; design capacity 4000 mAh. The raw values are logged once per boot.
- kern.sweet_spmi_addr / kern.sweet_spmi_dump: read-only 16-byte PMIC dump (allowed blocks only), to calibrate
  registers on the phone without a rebuild.

Sources: register numbers from Linux rtc-pm8xxx.c, downstream qpnp-fg-gen4.c / fg-reg.h / smb5-reg.h and
sm8150 / pm8150 / pm8150b device trees (values only, no code copied).

diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 362a89b..2f0b945 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -159,6 +159,15 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		    peripheral == 0x45)) ||
 		    (sid == 3 && (peripheral == 0xd8 || peripheral == 0xd9)) ||
 		    (sid == 0 && (peripheral == 0x08 || peripheral == 0x60 || peripheral == 0x61));  /* 0x60/0x61: PM8998 RTC, alarm (sweet_rtc_*) */
+	} else if (sweet_board_raphael()) {
+		/*
+		 * raphael (0262), status registers only (no FG SRAM / MEM_IF access): PM8150 (SID 0) RTC 0x60 and its alarm
+		 * 0x61; PM8150B (SID 2) SMB5 charger CHGR 0x10, DCDC 0x11, BATIF 0x12, USBIN 0x13, TYPEC 0x15, MISC 0x16 and
+		 * FG gen4 BATT_SOC 0x40 / BATT_INFO 0x41.
+		 */
+		allowed = (sid == 0 && (peripheral == 0x60 || peripheral == 0x61)) ||
+		    (sid == 2 && (peripheral == 0x10 || peripheral == 0x11 || peripheral == 0x12 || peripheral == 0x13 ||
+		    peripheral == 0x15 || peripheral == 0x16 || peripheral == 0x40 || peripheral == 0x41));
 	} else {
 		allowed = sid == 0 && (peripheral == 0x10 || peripheral == 0x11 ||
 		    peripheral == 0x12 || peripheral == 0x13 || peripheral == 0x48);
@@ -227,6 +236,10 @@ sweet_spmi_charger_writes(void)
 static bool
 sp_write_allowed(unsigned sid, unsigned addr, unsigned len)
 {
+	if (sweet_board_raphael()) {
+		/* 0262: only the PM8150 RTC alarm data 0x6140-0x6143 (the wall-clock offset, sweet_rtc_set) */
+		return sid == 0 && len >= 1 && len <= 2 && addr >= 0x6140u && addr + len <= 0x6144u;
+	}
 	if (!sweet_board_beryllium() || len < 1 || len > 2) {
 		return false;
 	}
@@ -416,7 +429,8 @@ static int
 sr_raw(uint32_t *raw)
 {
 	uint8_t ctrl = 0, b0 = 0;
-	if (!sweet_board_beryllium() || sweet_spmi_init() != 0 || sweet_spmi_read(0, SR_RTC_CTRL, &ctrl) != 0 ||
+	if ((!sweet_board_beryllium() && !sweet_board_raphael()) || sweet_spmi_init() != 0 ||
+	    sweet_spmi_read(0, SR_RTC_CTRL, &ctrl) != 0 ||
 	    !(ctrl & SR_EN)) {
 		return -1;
 	}
@@ -482,4 +496,36 @@ sweet_rtc_set(uint64_t unix_secs)
 	    sr_read32(SR_ALARM_DATA, &back) == 0 && back == want;
 	printf("SWEET RTC: offset %u -> %u (raw %u, time %llu)%s\n", off, want, raw, unix_secs, ok ? "" : " FAILED");
 }
+
+/*
+ * 0262: read-only PMIC register dump for calibration on the phone, limited to what sweet_spmi_read allows.
+ *   sysctl -w kern.sweet_spmi_addr=$(( (SID << 16) | ADDR ))   then   sysctl kern.sweet_spmi_dump   (16 bytes from ADDR)
+ */
+#include <sys/sysctl.h>
+static int sp_peek_addr = 0x24000;
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_spmi_addr, CTLFLAG_RW | CTLFLAG_LOCKED, &sp_peek_addr, 0,
+    "PMIC dump start: (SID << 16) | address (kern.sweet_spmi_dump)");
+
+static int
+sweet_spmi_dump_sysctl SYSCTL_HANDLER_ARGS
+{
+	(void)arg1;
+	(void)arg2;
+	char buf[16 * 3 + 32];
+	unsigned sid = ((unsigned)sp_peek_addr >> 16) & 0xfu, addr = (unsigned)sp_peek_addr & 0xffffu;
+	int n = snprintf(buf, sizeof(buf), "%u:%04x:", sid, addr);
+	for (unsigned i = 0; i < 16 && n > 0 && n < (int)sizeof(buf) - 4; i++) {
+		uint8_t v = 0;
+		if (sweet_spmi_init() == 0 && addr + i <= 0xffffu && sweet_spmi_read(sid, addr + i, &v) == 0) {
+			n += snprintf(buf + n, sizeof(buf) - (size_t)n, " %02x", v);
+		} else {
+			n += snprintf(buf + n, sizeof(buf) - (size_t)n, " --");
+		}
+	}
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_spmi_dump, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sweet_spmi_dump_sysctl, "A",
+    "16 PMIC bytes from kern.sweet_spmi_addr (allowed blocks only; -- = refused or unreadable)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
