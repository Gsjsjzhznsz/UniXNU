+/*
+ * raphael (0262): PM8150B (SID 2) FG gen4 + SMB5 charger, read-only (registers as downstream qpnp-fg-gen4 /
+ * smb5-reg.h): monotonic SOC BATT_SOC 0x4009 (0..255, same scaling as gen3), VBATT/IBATT BATT_INFO 0x41a0/0x41a2,
+ * USBIN_INT_RT_STS 0x1310 bit 4 (plugged in), BATTERY_CHARGER_STATUS_1 0x1006 bits 2:0 (1-4 charging,
+ * 5 TERMINATE). The VBATT scale is checked against both known LSBs (122.07 uV gen3, 194.637 uV) and the raw
+ * values are logged once, to calibrate with kern.sweet_spmi_dump.
+ */
+void
+SweetBattery::pollRaphael(void)
+{
+	static bool told;
+	const unsigned sid = 2;
+	uint8_t msoc = 0, msoc2 = 1, usb = 0, charger = 0;
+	uint16_t rawVoltage = 0, rawCurrent = 0;
+	bool valid = fReal;
+	for (unsigned i = 0; valid && i < 5; ++i) {
+		valid = !sweet_spmi_read(sid, 0x4009, &msoc) && !sweet_spmi_read(sid, 0x4009, &msoc2);
+		if (msoc == msoc2) {
+			break;
+		}
+	}
+	valid = valid && msoc == msoc2 &&
+	    readWord(0x41a0, &rawVoltage, sid) &&
+	    !sweet_spmi_read(sid, 0x1310, &usb) &&
+	    !sweet_spmi_read(sid, 0x1006, &charger);
+	unsigned mv122 = (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u);
+	unsigned mv194 = (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u);
+	unsigned mv = (mv122 >= 2800 && mv122 <= 4600) ? mv122 : (mv194 >= 2800 && mv194 <= 4600) ? mv194 : 0;
+	bool currentValid = valid && readWord(0x41a2, &rawCurrent, sid);
+	if (!told) {
+		told = true;
+		IOLog("SWEET BATTERY: raphael PM8150B raw: msoc %u (%u) vbatt 0x%04x (%u mV @122.07 uV, %u mV @194.637 uV) "
+		    "ibatt 0x%04x usbin_rt 0x%02x chgr_status1 0x%02x%s\n", msoc, msoc2, rawVoltage, mv122, mv194, rawCurrent,
+		    usb, charger, valid ? "" : " (read refused/failed)");
+	}
+	valid = valid && mv != 0;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	unsigned percent = msoc == 255 ? 100 : msoc == 0 ? 0 :
+	    ((unsigned)(msoc - 1) * 98u + 126u) / 253u + 1u;
+	bool external = (usb & 0x10u) != 0;          /* USBIN_PLUGIN_RT_STS */
+	unsigned state = charger & 7u;
+	bool charging = external && state >= 1 && state <= 4;
+	bool full = external && state == 5;          /* TERMINATE_CHARGE */
+	int ma = 0;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* FG: positive = discharging, 488.281 uA/bit (gen3 LSB; checked on the phone); IOPMPowerSource: positive = charging */
+		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+		if (ma < -8000 || ma > 8000) {
+			currentValid = false;
+			ma = 0;
+		}
+	}
+	publish(full ? 100 : percent, mv, ma, external, external, charging, full, true, currentValid);
+}
+
