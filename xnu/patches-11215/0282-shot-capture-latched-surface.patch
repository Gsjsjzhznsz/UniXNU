fb: screenshot the surface the panel is reading, not the newest submitted (0282)

kern.sweet_fb_shot copied the surface named by fShotId, set when a frame is handed
to the pipe. The panel latches up to a frame later, so a capture could show a frame
that never reached the glass, making any screenshot inconclusive.

Prefer the surface behind fScanoutPin[0], the IOVA the panel latched. fScanoutMaps[]
owns that surface, so the pointer is borrowed and must not be released; only the
by-id path takes (and therefore releases) a reference. The first version of this
patch released the borrowed pointer, which over-released the surface and wedged the
device -- that is why the release is now guarded by 'borrowed'.

--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -978,13 +978,39 @@
 {
 	AppleCLCD *fb = __atomic_load_n(&sweet_fb_shot_fb, __ATOMIC_ACQUIRE);
 	SweetSurface *s = NULL;
+	bool borrowed = false;
 	uintptr_t src = 0;
 	uint32_t w, h, stride;
+	uint32_t id = 0, f = 0;         /* 0282: hoisted so the pin fast path can jump to copy */
 
 	if (fb == NULL || scale == 0) {
 		return ENODEV;
 	}
-	uint32_t id = __atomic_load_n(&fb->fShotId, __ATOMIC_ACQUIRE);
+	/*
+	 * 0282: capture the surface the panel is reading, not the newest submitted one. fShotId is set
+	 * when a frame is handed to the pipe; the panel latches up to a frame later, so only the pinned
+	 * IOVA is guaranteed to be what the eye is looking at.
+	 *
+	 * fScanoutMaps[] owns the reference to that surface, so the pointer is borrowed here and must
+	 * not be released -- releasing it would drop a reference this path never took.
+	 */
+	if (fb->fScanoutPin[0] != 0) {
+		for (unsigned i = 0; i < SWEET_SCANOUT_MAPS; i++) {
+			if (fb->fScanoutMaps[i].s != NULL && fb->fScanoutMaps[i].iova == fb->fScanoutPin[0]) {
+				s = fb->fScanoutMaps[i].s;
+				borrowed = true;
+				break;
+			}
+		}
+	}
+	if (s != NULL && s->kernelAddress() != 0 && s->width >= fb->fLogicalW && s->height >= fb->fLogicalH) {
+		src = s->kernelAddress() + s->offset;
+		w = fb->fLogicalW;
+		h = fb->fLogicalH;
+		stride = s->bytesPerRow;
+		goto copy;                      /* borrowed: nothing to release */
+	}
+	id = __atomic_load_n(&fb->fShotId, __ATOMIC_ACQUIRE);
 	if ((fb->fZcFront || fb->fScanFront) && id != 0 && (s = sweet_surface_copy(id)) != NULL && s != fb->fSurface &&
 	    s->kernelAddress() != 0 && s->width >= fb->fLogicalW && s->height >= fb->fLogicalH) {
 		src = s->kernelAddress() + s->offset;
@@ -993,7 +1019,7 @@
 		stride = s->bytesPerRow;
 	} else {
 		OSSafeReleaseNULL(s);
-		uint32_t f = fb->fFlip ? fb->fFront : 0;
+		f = fb->fFlip ? fb->fFront : 0;
 		src = f < 3 && fb->fFlip ? fb->fBufVA[f] : fb->fPixels;
 		if (f != 0 && fb->fHw) {
 			w = fb->fLogicalW;
@@ -1005,6 +1031,7 @@
 			stride = fb->fRowBytes;
 		}
 	}
+copy:
 	uint32_t dw = w / scale, dh = h / scale;
 	if (src == 0 || dw == 0 || dh == 0 || (uint64_t)dw * dh * 4 > cap) {
 		OSSafeReleaseNULL(s);
@@ -1017,7 +1044,9 @@
 			out[x] = in[x * scale];
 		}
 	}
-	OSSafeReleaseNULL(s);
+	if (!borrowed) {
+		OSSafeReleaseNULL(s);   /* 0282: only the by-id path owns a reference */
+	}
 	*ow = dw;
 	*oh = dh;
 	return 0;
