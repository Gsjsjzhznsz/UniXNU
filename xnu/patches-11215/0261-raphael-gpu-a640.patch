+/*
+ * BCM resource: address and its 8-byte aux record (struct bcm_db: u32 unit,
+ * u16 width, u8 vcd, u8 reserved), as KGSL/Linux qcom_icc_bcm_init read it.
+ */
+static bool
+cmddb_bcm(const char *res, uint32_t *address, uint32_t *unit, uint16_t *width, uint8_t *vcd)
+{
+	uint32_t key[2] = { 0, 0 };
+	unsigned matches = 0;
+
+	if (!cmddb_map()) {
+		return false;
+	}
+	for (unsigned i = 0; i < 8 && res[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = CMDDB_HEADER + db16(h + 2);
+		uint32_t aux = CMDDB_HEADER + db16(h + 4);
+		unsigned count = db16(h + 6);
+		if (slave != CMDDB_SLAVE_BCM || (entries & 3u) || !db_range(entries, count * CMDDB_ENTRY)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + CMDDB_ENTRY * j;
+			if (db_rd(e) != key[0] || db_rd(e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t off = aux + db16(e + 22), len = db16(e + 20);
+			if (len < 8 || !db_range(off, 8)) {
+				return false;
+			}
+			*address = db_rd(e + 16);
+			*unit = (uint32_t)db16(off) | ((uint32_t)db16(off + 2) << 16);
+			*width = db16(off + 4);
+			*vcd = (uint8_t)db16(off + 6);
+			matches++;
+		}
+	}
+	return matches == 1;
+}
