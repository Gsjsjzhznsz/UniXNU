+/*
+ * A640 block-format GMU firmware (a6xx_gmu_fw_load, non-legacy): a sequence of
+ * { u32 addr, u32 size, u32 type, u32 value } headers, each followed by size
+ * bytes. Blocks in the ITCM (GMU 0x0-0x3fff) or DTCM (0x40000-0x43fff) go
+ * through the TCM registers, everything else into the icache/dcache regions
+ * mapped at GMU VA 0x4000-0x7ffff. raphael's a640_gmu.bin (37680 bytes, same
+ * as nabu's): ITCM 0x0/0x200/0x400, icache 0x4000, DTCM 0x40000 and 0x43fe0
+ * (the version words), dcache 0x57000.
+ */
+static bool
+a640_fw_load(const uint8_t *fw, size_t size)
+{
+	size_t c = 0;
+	unsigned blocks = 0, bad = 0;
+
+	if (!gcache) {
+		printf("SWEET GPU: GMU cache regions not allocated\n");
+		return false;
+	}
+	bzero((void *)gcache, GCACHE_SIZE);
+	while (c < size) {
+		uint32_t h[4];
+		if (size - c < 16) {
+			printf("SWEET GPU: GMU firmware: truncated block header at %lu\n", (unsigned long)c);
+			return false;
+		}
+		memcpy(h, fw + c, 16);
+		c += 16;
+		uint32_t addr = h[0], len = h[1];
+		if (len > size - c || (addr & 3) || (len & 3) || len > 0xffffffffu - addr) {
+			printf("SWEET GPU: GMU firmware: bad block at %lu: addr %#x size %#x\n", (unsigned long)(c - 16), addr, len);
+			return false;
+		}
+		const char *where;
+		if (addr + len <= GMU_TCM_SIZE) {
+			where = "ITCM";
+			for (uint32_t o = 0; o < len; o += 4) {
+				uint32_t w;
+				memcpy(&w, fw + c + o, 4);
+				gpu_wr(gmu, GMU_CM3_ITCM + addr + o, w);
+				bad += gpu_rd(gmu, GMU_CM3_ITCM + addr + o) != w;
+			}
+		} else if (addr >= 0x40000u && addr + len <= 0x40000u + GMU_TCM_SIZE) {
+			where = "DTCM";
+			for (uint32_t o = 0; o < len; o += 4) {
+				uint32_t w;
+				memcpy(&w, fw + c + o, 4);
+				gpu_wr(gmu, GMU_CM3_DTCM + (addr - 0x40000u) + o, w);
+				bad += gpu_rd(gmu, GMU_CM3_DTCM + (addr - 0x40000u) + o) != w;
+			}
+		} else if (addr >= GMU_VA_CACHE && addr + len <= GMU_VA_CACHE + GCACHE_SIZE) {
+			where = addr < GMU_DCACHE_VA ? "icache" : "dcache";
+			memcpy((void *)(gcache + (addr - GMU_VA_CACHE)), fw + c, len);
+		} else {
+			printf("SWEET GPU: GMU firmware block addr %#x size %#x is outside the TCMs and cache regions\n", addr, len);
+			return false;
+		}
+		printf("SWEET GPU: GMU firmware block %u: addr %#07x size %#06x -> %s\n", blocks, addr, len, where);
+		blocks++;
+		c += len;
+	}
+	sweet_dma_sync_va((const void *)gcache, GCACHE_SIZE);
+	printf("SWEET GPU: GMU firmware %lu bytes, %u blocks, %u TCM words differ on readback\n", (unsigned long)size, blocks, bad);
+	return blocks > 0 && bad == 0;
+}
