+/* ------------------------------------------------------------------ */
+/* A640 (SM8150): AOP QMP mailbox, host rail votes, CX power-up        */
+/* ------------------------------------------------------------------ */
+
+#define AOP_MSGRAM_PA           0x0c300000u     /* aop_qmp message RAM (msm_qmp.c) */
+#define AOP_MSGRAM_SIZE         0x400u
+#define AOP_DOORBELL_PA         0x17c00000u     /* APCS IPC: offset 0xc, value BIT(0) */
+#define AOP_DOORBELL_OFF        0x0cu
+#define QMP_MAGIC               0x4d41494cu
+#define RPMH_DRV2_PA            0x18220000u     /* apps_rsc DRV2 (sm8150): TCSes from +0xd00, 672 bytes each */
+#define RPMH_DRV2_SIZE          0x10000u
+#define RPMH_TCS_BASE           0xd00u
+#define RPMH_TCS_STRIDE         672u
+#define RPMH_IRQ_STATUS         (RPMH_TCS_BASE + 0x04u)
+#define RPMH_IRQ_CLEAR          (RPMH_TCS_BASE + 0x08u)
+#define TCS_WAIT_FOR_CMPL       0x10u
+#define TCS_CONTROL             0x14u
+#define TCS_CMD_ENABLE          0x1cu
+#define TCS_CMD(n)              (0x30u + 20u * (n))     /* MSGID, ADDR (+4), DATA (+8), STATUS (+0xc) */
+#define TCS_AMC_MODE_EN         (1u << 16)
+#define TCS_AMC_MODE_TRIGGER    (1u << 24)
+#define GPUCC_CX_GDS_HW_CTRL_ON GDSC_PWR_ON
+
+/* DCVS tables (filled by gpu_dcvs_votes; also needed by the A640 rail votes below) */
+#define MAX_GX_LEVELS           16
+#define MAX_CX_LEVELS           4
+static uint32_t gx_votes[MAX_GX_LEVELS], cx_votes[MAX_CX_LEVELS];
+static uint32_t gx_khz[MAX_GX_LEVELS], cx_khz[MAX_CX_LEVELS];
+static unsigned gx_levels;
+
+static vm_offset_t aop_ram, aop_bell;
+static uint32_t qmp_off, qmp_size;
+static bool qmp_up;
+static bool a640_cx_cold;                       /* the CX GDSC was off when we found it: the SMMU needs a reset */
+static uint32_t a640_votes = 1;                 /* sweetgpuvote=0: no host rail votes */
+/*
+ * sweetgmuvar (A640 GMU boot experiments; 0 = the Linux a640 sequence):
+ *   1  PDC third TCS command votes gfx.lvl from cmd-db (old) instead of xo.lvl (Linux 0x30090)
+ *   2  no a6xx_rpmh_stop after the RPMh microcode load (old)
+ *   4  vendor AHB fence range 0x80a008a0 instead of Linux (0xa << 18) | 0xa0
+ *   8  GMU pages EL0-accessible (old; implicitly PXN, so the GMU cannot execute from its icache region)
+ *   16 SMMU context faults terminate instead of stall (SCTLR.CFCFG = 0)
+ */
+static uint32_t a640_gmuvar;
+
+static void
+qmp_ring(void)
+{
+	gpu_wr(aop_bell, AOP_DOORBELL_OFF, 1);
+}
+
+/* msm_qmp.c: link and channel negotiation with the AOP (ucore = AOP at 12..24, mcore = us at 36..48). */
+static bool
+qmp_open(void)
+{
+	if (qmp_up) {
+		return true;
+	}
+	if ((!aop_ram && !(aop_ram = ml_io_map(AOP_MSGRAM_PA, AOP_MSGRAM_SIZE))) ||
+	    (!aop_bell && !(aop_bell = ml_io_map(AOP_DOORBELL_PA, 0x1000)))) {
+		printf("SWEET GPU: AOP QMP map failed\n");
+		return false;
+	}
+	uint32_t magic = gpu_rd(aop_ram, 0), ver = gpu_rd(aop_ram, 4);
+	qmp_size = gpu_rd(aop_ram, 52);
+	qmp_off = gpu_rd(aop_ram, 56);
+	printf("SWEET GPU: AOP QMP magic %#x version %u mailbox %#x/%#x ucore %#x/%#x/%#x/%#x mcore %#x/%#x/%#x/%#x\n",
+	    magic, ver, qmp_off, qmp_size, gpu_rd(aop_ram, 12), gpu_rd(aop_ram, 16), gpu_rd(aop_ram, 20), gpu_rd(aop_ram, 24),
+	    gpu_rd(aop_ram, 36), gpu_rd(aop_ram, 40), gpu_rd(aop_ram, 44), gpu_rd(aop_ram, 48));
+	if (magic != QMP_MAGIC || ver != 1 || qmp_off < 64 || (qmp_off & 3) || qmp_size < 36 ||
+	    qmp_off > AOP_MSGRAM_SIZE || qmp_size > AOP_MSGRAM_SIZE - qmp_off) {
+		printf("SWEET GPU: AOP QMP descriptor not usable\n");
+		return false;
+	}
+	gpu_wr(aop_ram, 16, gpu_rd(aop_ram, 12));      /* ack the remote link state */
+	gpu_wr(aop_ram, 36, 0xffff);                    /* local link up */
+	qmp_ring();
+	if (!gpu_poll(aop_ram, 40, 0xffffffffu, 0xffff, 1000000)) {
+		printf("SWEET GPU: AOP QMP link not acknowledged (%#x)\n", gpu_rd(aop_ram, 40));
+		return false;
+	}
+	gpu_wr(aop_ram, 44, 0xffff);                    /* local channel open */
+	qmp_ring();
+	for (unsigned i = 0; i < 100000; i++) {
+		uint32_t remote = gpu_rd(aop_ram, 20);
+		gpu_wr(aop_ram, 24, remote);
+		if (remote == 0xffff && gpu_rd(aop_ram, 48) == 0xffff) {
+			qmp_up = true;
+			printf("SWEET GPU: AOP QMP channel open\n");
+			return true;
+		}
+		qmp_ring();
+		delay(10);
+	}
+	printf("SWEET GPU: AOP QMP channel did not open (remote %#x ack %#x)\n", gpu_rd(aop_ram, 20), gpu_rd(aop_ram, 48));
+	return false;
+}
+
+/* msm_qmp.c qmp_send_data: size word, then the text; the AOP clears the size word when it has taken the message. */
+static bool
+qmp_send(const char *msg)
+{
+	size_t len = strlen(msg);
+	uint32_t bytes = (uint32_t)((len + 1 + 3) & ~(size_t)3);
+
+	if (!qmp_up || bytes + 4 > qmp_size) {
+		return false;
+	}
+	if (!gpu_poll(aop_ram, qmp_off, 0xffffffffu, 0, 100000)) {
