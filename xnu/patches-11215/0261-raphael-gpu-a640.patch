+/*
+ * SM8150 CX power-up in the nabu vendor order: cmd-db tables, QMP (ACD off), parent rail votes, GPLL0 + GCC branches,
+ * the CX GDSC through the AOP (gpu_noc_wa), the GMU clock at 200 MHz, then the GPU CC and bus branches.
+ */
+static bool gpu_dcvs_votes(void);
+
+static bool
+a640_branch(vm_offset_t base, uint32_t off, const char *name, bool wait)
+{
+	gpu_wr(base, off, gpu_rd(base, off) | CBCR_CLK_ENABLE);
+	if (!wait) {
+		delay(10);
+		return true;
+	}
+	return gpu_branch_on(base, off, name);
+}
+
+static bool
+a640_power_cx(void)
+{
+	if (!gpu_dcvs_votes()) {
+		return false;
+	}
+	if (!qmp_open() || !qmp_send("{class: gpu, res: acd, value: 0}")) {
+		return false;
+	}
+	if (!a640_rail_votes()) {
+		return false;
+	}
+	gpu_wr(gcc, GCC_GPLL0_ENA_VOTE, gpu_rd(gcc, GCC_GPLL0_ENA_VOTE) | 1u);
+	if (!gpu_poll(gcc, GCC_GPLL0_MODE, 1u << 31, 1u << 31, 1000)) {
+		printf("SWEET GPU: GPLL0 not locked (mode %#x)\n", gpu_rd(gcc, GCC_GPLL0_MODE));
+		return false;
+	}
+	if ((gpu_rd(gcc, GCC_GPU_GPLL0_VOTE) & (GCC_GPU_GPLL0 | GCC_GPU_GPLL0_DIV)) != (GCC_GPU_GPLL0 | GCC_GPU_GPLL0_DIV)) {
+		gpu_wr(gcc, GCC_GPU_GPLL0_VOTE, gpu_rd(gcc, GCC_GPU_GPLL0_VOTE) | GCC_GPU_GPLL0 | GCC_GPU_GPLL0_DIV);
+	}
+	delay(10);
+	(void)a640_branch(gcc, GCC_GPU_CFG_AHB_CBCR, "gpu_cfg_ahb", false);
+
+	uint32_t g = gpu_rd(cc, GPUCC_CX_GDSCR), st = gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL);
+	printf("SWEET GPU: CX GDSC inherited gdscr %#x hw status %#x\n", g, st);
+	if (!(st & GDSC_PWR_ON)) {
+		a640_cx_cold = true;
+		if (g & GDSC_HW_CONTROL) {
+			printf("SWEET GPU: CX GDSC under HW control; not touched\n");
+			return false;
+		}
+		if (g & GDSC_SW_COLLAPSE) {
+			(void)qmp_send("{class: clock, res: gpu_noc_wa}");
+		}
+		delay(1);
+		if (!gpu_poll(cc, GPUCC_CX_GDS_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, 5000)) {
+			/* not switched on by the AOP: the generic GDSC enable, as on the Poco F1 */
+			printf("SWEET GPU: CX GDSC still off after gpu_noc_wa (%#x); clearing SW_COLLAPSE\n", gpu_rd(cc, GPUCC_CX_GDSCR));
+			uint32_t v = (gpu_rd(cc, GPUCC_CX_GDSCR) & ~GDSC_CLK_DIS_WAIT_MASK) | GDSC_CLK_DIS_WAIT(8);
+			gpu_wr(cc, GPUCC_CX_GDSCR, v);
+			gpu_wr(cc, GPUCC_CX_GDSCR, v & ~GDSC_SW_COLLAPSE);
+			delay(1);
+			if (!gpu_poll(cc, GPUCC_CX_GDS_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, 5000)) {
+				printf("SWEET GPU: CX GDSC enable timed out: gdscr %#x hw status %#x\n",
+				    gpu_rd(cc, GPUCC_CX_GDSCR), gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL));
+				return false;
+			}
+		}
+	}
+	printf("SWEET GPU: CX GDSC on: gdscr %#x hw status %#x\n", gpu_rd(cc, GPUCC_CX_GDSCR), gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL));
+
+	gpu_wr(cc, GPUCC_GMU_CFG_RCGR, (gpu_rd(cc, GPUCC_GMU_CFG_RCGR) & ~0x71fu) | GMU_RCG_CFG_200MHZ);
+	gpu_wr(cc, GPUCC_GMU_CMD_RCGR, gpu_rd(cc, GPUCC_GMU_CMD_RCGR) | RCG_CMD_UPDATE);
+	if (!gpu_poll(cc, GPUCC_GMU_CMD_RCGR, RCG_CMD_UPDATE, 0, 1000)) {
+		printf("SWEET GPU: GMU RCG update timed out: cmd %#x cfg %#x\n", gpu_rd(cc, GPUCC_GMU_CMD_RCGR), gpu_rd(cc, GPUCC_GMU_CFG_RCGR));
+		return false;
+	}
+	bool ok = gpu_branch_on(cc, 0x1004, "cxo_aon");
+	ok &= gpu_branch_on(cc, gpucc_cbcr[CC_CXO].off, "cxo");
+	(void)a640_branch(cc, gpucc_cbcr[CC_AHB].off, "ahb", false);
+	ok &= gpu_branch_on(cc, 0x107c, "crc_ahb");
+	ok &= gpu_branch_on(cc, gpucc_cbcr[CC_CX_GMU].off, "cx_gmu");
+	ok &= gpu_branch_on(cc, gpucc_cbcr[CC_CX_SNOC_DVM].off, "cx_snoc_dvm");
+	ok &= gpu_branch_on(cc, 0x1090, "sleep");
