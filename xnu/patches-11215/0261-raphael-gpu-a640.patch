+	gpu_branch_on(gcc, GCC_GPU_MEMNOC_GFX_CBCR, "memnoc_gfx");
+	ok &= gpu_branch_on(gcc, GCC_GPU_SNOC_DVM_GFX, "snoc_dvm_gfx");
+	printf("SWEET GPU: A640 CX power-up %s\n", ok ? "complete" : "INCOMPLETE (a branch stayed off)");
+	return ok;
+}
