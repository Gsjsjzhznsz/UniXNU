+/*
+ * Active-only ARC votes of the GPU's parent rails (mx, cx, gfx) and XO through a free APPS DRV2 active TCS, as the
+ * nabu vendor flow holds them while the GPU runs; the GMU's own RSC does the GX/MX work after boot.
+ */
+static bool
+a640_rail_votes(void)
+{
+	uint32_t mx = 0, cx = 0, gfx = 0, xo = 0;
+	uint16_t lv[16];
+	unsigned n;
+
+	if (!a640_votes) {
+		printf("SWEET GPU: host rail votes off (sweetgpuvote=0)\n");
+		return true;
+	}
+	if (cmddb_lookup("mx.lvl", &mx, lv, 16, &n) != (int)CMDDB_SLAVE_ARC || cmddb_lookup("cx.lvl", &cx, lv, 16, &n) != (int)CMDDB_SLAVE_ARC ||
+	    cmddb_lookup("gfx.lvl", &gfx, lv, 16, &n) != (int)CMDDB_SLAVE_ARC || cmddb_lookup("xo.lvl", &xo, lv, 16, &n) != (int)CMDDB_SLAVE_ARC) {
+		printf("SWEET GPU: cmd-db ARC lookup for the rail votes failed\n");
+		return false;
+	}
+	vm_offset_t rsc = ml_io_map(RPMH_DRV2_PA, RPMH_DRV2_SIZE);
+	if (!rsc) {
+		return false;
+	}
+	uint32_t cfg = gpu_rd(rsc, 0x0c);
+	if (((cfg >> 12) & 0x3f) < 2 || (cfg >> 27) < 4) {
+		printf("SWEET GPU: APPS DRV2 config %#x: no active TCS with 4 commands\n", cfg);
+		return false;
+	}
+	unsigned tcs;
+	for (tcs = 0; tcs < 2 && gpu_rd(rsc, RPMH_TCS_BASE + tcs * RPMH_TCS_STRIDE + TCS_CMD_ENABLE); tcs++) {
+	}
+	if (tcs == 2) {
+		printf("SWEET GPU: both APPS DRV2 active TCSes are in use; no rail votes\n");
+		return false;
+	}
+	uint32_t base = RPMH_TCS_BASE + tcs * RPMH_TCS_STRIDE, ctl = gpu_rd(rsc, base + TCS_CONTROL);
+	const uint32_t addr[4] = { mx, cx, gfx, xo };
+	/* gx_votes/cx_votes level 1: low byte primary ARC index, byte 1 the secondary (mx) index */
+	uint32_t mxi = MAX((gx_votes[1] >> 8) & 0xffu, (cx_votes[1] >> 8) & 0xffu);
+	const uint32_t data[4] = { mxi, cx_votes[1] & 0xffu, gx_votes[1] & 0xffu, 3 };
+	/* trigger removal before AMC mode is cleared */
+	const uint32_t steps[3] = { ctl & ~TCS_AMC_MODE_TRIGGER, ctl & ~(TCS_AMC_MODE_TRIGGER | TCS_AMC_MODE_EN), TCS_AMC_MODE_EN };
+	for (unsigned i = 0; i < 3; i++) {
+		gpu_wr(rsc, base + TCS_CONTROL, steps[i]);
+		if (!gpu_poll(rsc, base + TCS_CONTROL, 0xffffffffu, steps[i], 1000)) {
+			printf("SWEET GPU: TCS%u control did not take %#x\n", tcs, steps[i]);
+			return false;
+		}
+	}
+	gpu_wr(rsc, RPMH_IRQ_CLEAR, 1u << tcs);
+	for (unsigned c = 0; c < 4; c++) {
+		gpu_wr(rsc, base + TCS_CMD(c), 0x10108);
+		gpu_wr(rsc, base + TCS_CMD(c) + 4, addr[c]);
+		gpu_wr(rsc, base + TCS_CMD(c) + 8, data[c]);
+	}
+	gpu_wr(rsc, base + TCS_WAIT_FOR_CMPL, 0xf);
+	gpu_wr(rsc, base + TCS_CMD_ENABLE, 0xf);
+	gpu_wr(rsc, base + TCS_CONTROL, TCS_AMC_MODE_EN | TCS_AMC_MODE_TRIGGER);
+	bool ok = gpu_poll(rsc, RPMH_IRQ_STATUS, 1u << tcs, 1u << tcs, 100000);
+	for (unsigned c = 0; ok && c < 4; c++) {
+		ok = gpu_poll(rsc, base + TCS_CMD(c) + 0xc, (1u << 8) | (1u << 16), (1u << 8) | (1u << 16), 1000);
+	}
+	gpu_wr(rsc, base + TCS_CMD_ENABLE, 0);
+	gpu_wr(rsc, RPMH_IRQ_CLEAR, 1u << tcs);
+	printf("SWEET GPU: rail votes TCS%u: mx %#x=%u cx %#x=%u gfx %#x=%u xo %#x=3: %s\n", tcs, mx, data[0], cx, data[1], gfx, data[2],
+	    xo, ok ? "completed" : "NOT completed");
+	return ok;
+}
