 	if (mdpPa != SWEET_MDP_PA) {
 		IOLog("SWEET MDP: window overridden to 0x%x (default 0x%x)\n", mdpPa, SWEET_MDP_PA);
 	}
-	fMdp = ml_io_map(mdpPa, SWEET_MDP_SIZE);
