diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -240,6 +240,44 @@
 }
 
 /*
+ * READ ONLY diagnostic (boot-arg sweetfb_smmu_scan=1): dump every valid stream
+ * match register with the S2CR it selects. On a board whose MDP stream ids are
+ * not documented (raphael/SM8150) this shows which ids exist and whether they
+ * are bypass, translate or fault, so sweetfb_sid_a/sweetfb_sid_b can be set
+ * without guessing. Nothing is written and no bank is created.
+ */
+void
+sweet_smmu_dump_smr(void)
+{
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (smmu_base == 0) {
+		smmu_base = ml_io_map(SMMU_PA, SMMU_SIZE);
+	}
+	if (smmu_base == 0) {
+		printf("SWEET SMMU: scan: map failed\n");
+		goto out;
+	}
+	uint32_t id0 = smmu_rd(0x20), id1 = smmu_rd(0x24);
+	unsigned nsmr = id0 & 0xff;
+	printf("SWEET SMMU: scan: sCR0 0x%x ID0 0x%x ID1 0x%x, %u SMRs\n", smmu_rd(0x0), id0, id1, nsmr);
+	for (unsigned i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i);
+		if (!(smr & (1u << 31))) {
+			continue;
+		}
+		uint32_t s2cr = smmu_rd(0xc00 + 4 * i);
+		unsigned type = (s2cr >> 16) & 3;
+		printf("SWEET SMMU: scan: smr %u 0x%x id 0x%x mask 0x%x s2cr 0x%x type %s cb %u\n",
+		    i, smr, smr & 0x7fff, (smr >> 16) & 0x7fff, s2cr,
+		    type == 0 ? "TRANSLATE" : (type == 1 ? "BYPASS" : "FAULT"), s2cr & 0xff);
+	}
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+}
