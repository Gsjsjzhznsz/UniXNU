+//
+// Bring-up diagnostics (UniXNU-raphael): the last log lines, shown on screen
+// when an entry fails, for devices whose serial log cannot be read.
+//
+#define DIAG_LOG_LINES   14
+#define DIAG_LOG_CHARS   80
+#define DIAG_TEXT_LINES  32
+#define DIAG_TEXT_CHARS  128
+#define DIAG_RANGES      128
+
+STATIC CHAR8   mDiagLog[DIAG_LOG_LINES][DIAG_LOG_CHARS];
+STATIC UINTN   mDiagLogCount;
+STATIC CHAR16  mDiagText[DIAG_TEXT_LINES][DIAG_TEXT_CHARS];
+STATIC UINT64  mDiagStart[DIAG_RANGES];
+STATIC UINT64  mDiagEnd[DIAG_RANGES];
+
