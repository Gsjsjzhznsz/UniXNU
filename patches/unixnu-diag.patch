+VOID
+UniXNUUiDrawDiag (
+  IN UNIXNU_UI            *Ui,
+  IN CONST CHAR16 *CONST  *Lines,
+  IN UINTN                Count
+  )
+{
+  CHAR16  Chunk[PORTRAIT_TEXT_MAX + 1];
+  UINTN   Fs;
+  UINTN   Pitch;
+  UINTN   Cw;
+  UINTN   Max;
+  UINTN   Y;
+  UINTN   Index;
+  UINTN   Offset;
+  UINTN   Len;
+  UINTN   Take;
+
+  if (Ui->Mode == UniXNUUiText) {
+    gST->ConOut->ClearScreen (gST->ConOut);
+    for (Index = 0; Index < Count; Index++) {
+      gST->ConOut->OutputString (gST->ConOut, (CHAR16 *)Lines[Index]);
+      gST->ConOut->OutputString (gST->ConOut, L"\r\n");
+    }
+
+    return;
+  }
+
+  if (Ui->Mode != UniXNUUiGraphics) {
+    return;
+  }
+
+  Fs    = FooterScale (Ui);
+  Pitch = FooterPitch (Ui);
+  Cw    = UNIXNU_GLYPH_WIDTH * Fs;
+  if (Ui->Width <= Cw) {
+    return;
+  }
+
+  Max = MIN ((Ui->Width - Cw) / Cw, (UINTN)PORTRAIT_TEXT_MAX);
+  FillRect (Ui, 0, 0, Ui->Width, Ui->Height, mBackground);
+  Y = Pitch;
+  for (Index = 0; Index < Count; Index++) {
+    Len    = StrLen (Lines[Index]);
+    Offset = 0;
+    do {
+      if (Y + Pitch > Ui->Height) {
+        return;
+      }
+
+      Take = MIN (Len - Offset, Max);
+      CopyMem (Chunk, Lines[Index] + Offset, Take * sizeof (CHAR16));
+      Chunk[Take] = L'\0';
+      DrawText (Ui, Cw / 2, Y, Chunk, Fs, (Index == 0) ? mError : mText, mBackground, 0);
+      Y      += Pitch;
+      Offset += Take;
+    } while (Offset < Len);
+  }
+}
