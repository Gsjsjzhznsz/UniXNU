   VA_END (Args);
+  AsciiStrnCpyS (mDiagLog[mDiagLogCount % DIAG_LOG_LINES], DIAG_LOG_CHARS, Line + Prefix, DIAG_LOG_CHARS - 1);
+  mDiagLogCount++;
   AsciiStrCatS (Line, sizeof (Line), "\r\n");
 
