diff --git a/DarwinBootPkg/Driver/DarwinBoot.c b/DarwinBootPkg/Driver/DarwinBoot.c
index ac2e56b..12f9b66 100644
--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -485,6 +485,7 @@ AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address
   UINT64                BestStart;
   UINT64                BestBytes;
   UINT64                RunBytes;
+  UINTN                 Pass;
 
   *Address = 0;
   Map = NULL;
@@ -494,17 +495,22 @@ AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address
   Status = GetMap (&Map, &Capacity, &Size, &Key, &Stride);
   if (EFI_ERROR (Status)) { if (Map != NULL) { FreePool (Map); } return Status; }
   Status = EFI_OUT_OF_RESOURCES;
-  for (Offset = 0; Offset + Stride <= Size; Offset += Stride) {
-    Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
-    if ((Descriptor->Type != EfiConventionalMemory) || (Descriptor->NumberOfPages == 0)) { continue; }
-    End = RunEnd (Map, Size, Stride, Descriptor->PhysicalStart,
-                  Descriptor->PhysicalStart + EFI_PAGES_TO_SIZE (Descriptor->NumberOfPages));
-    RunBytes = End - Descriptor->PhysicalStart;
-    if (RunBytes > BestBytes) { BestBytes = RunBytes; BestStart = Descriptor->PhysicalStart; }
-    Candidate = ALIGN_VALUE (Descriptor->PhysicalStart, KERNEL_BLOCK_SIZE) + (Kernel->Base & (KERNEL_BLOCK_SIZE - 1));
-    if ((Candidate < Descriptor->PhysicalStart) || (End < Candidate) || (End - Candidate < WindowSize)) { continue; }
-    Status = ReserveRange (Map, Size, Stride, Candidate, WindowSize);
-    if (!EFI_ERROR (Status)) { *Address = Candidate; break; }
+  // Pass 0 takes only a window that ends at or below 4 GiB, as on the boards this kernel was brought
+  // up on; pass 1 takes any run. The map is not sorted, so without this the first fit can be high.
+  for (Pass = 0; (Pass < 2) && (*Address == 0); Pass++) {
+    for (Offset = 0; Offset + Stride <= Size; Offset += Stride) {
+      Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
+      if ((Descriptor->Type != EfiConventionalMemory) || (Descriptor->NumberOfPages == 0)) { continue; }
+      End = RunEnd (Map, Size, Stride, Descriptor->PhysicalStart,
+                    Descriptor->PhysicalStart + EFI_PAGES_TO_SIZE (Descriptor->NumberOfPages));
+      RunBytes = End - Descriptor->PhysicalStart;
+      if (RunBytes > BestBytes) { BestBytes = RunBytes; BestStart = Descriptor->PhysicalStart; }
+      Candidate = ALIGN_VALUE (Descriptor->PhysicalStart, KERNEL_BLOCK_SIZE) + (Kernel->Base & (KERNEL_BLOCK_SIZE - 1));
+      if ((Candidate < Descriptor->PhysicalStart) || (End < Candidate) || (End - Candidate < WindowSize)) { continue; }
+      if ((Pass == 0) && (Candidate + WindowSize > SIZE_4GB)) { continue; }
+      Status = ReserveRange (Map, Size, Stride, Candidate, WindowSize);
+      if (!EFI_ERROR (Status)) { *Address = Candidate; break; }
+    }
   }
   if (EFI_ERROR (Status)) {
     CHAR16 Line[96];
