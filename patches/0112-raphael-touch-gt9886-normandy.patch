+	printf("SWEET TOUCH: selected GT9886 Normandy, %ux%u, sensor=%u flip=%u%s, poll=10ms irq-hint=%d\n",
+	    b->max_x + 1u, b->max_y + 1u, st.sensor, st.flip,
+	    flip >= 0 ? " (sweettouchflip)" : "", st.irq_hint);
+	return true;
