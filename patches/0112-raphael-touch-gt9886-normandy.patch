+/*
+ * GT9886 Normandy frame, vendor goodix_touch_handler: [0] status, [1] count
+ * in the low nibble, 8 bytes per point from [2] (id low nibble, x LE16,
+ * y LE16, width, ...), then key and checksum; the 8-bit sum over
+ * count * 8 + 4 bytes is zero. Pen records (>= 0x80) are dropped. flip
+ * bit 0 mirrors x and bit 1 mirrors y (DT goodix,x2x / goodix,y2y).
+ * No I/O: buf holds at least count * 8 + 4 bytes.
+ */
+static int
+touch_nor_parse(const uint8_t *buf, unsigned n, unsigned flip, unsigned max_x,
+    unsigned max_y, uint32_t *maskp, int *x, int *y)
+{
+	uint8_t sum = 0;
+	uint32_t mask = 0;
+	if (n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n * GOODIX_POINT_LEN + 4u; ++i) {
+		sum = (uint8_t)(sum + buf[i]);
+	}
+	if (sum) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2u + i * GOODIX_POINT_LEN;
+		if (p[0] & 0x80u) {
+			continue;
+		}
+		unsigned id = p[0] & 15u;
+		unsigned px = p[1] | ((unsigned)p[2] << 8);
+		unsigned py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > max_x || py > max_y) {
+			return EIO;
+		}
+		if (flip & 1u) {
+			px = max_x - px;
+		}
+		if (flip & 2u) {
+			py = max_y - py;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	*maskp = mask;
+	return 0;
+}
+
+static int
+touch_nor_write(uint16_t reg, uint8_t val)
+{
+	const uint8_t msg[3] = {(uint8_t)(reg >> 8), (uint8_t)reg, val};
+	return touch_msg(0x5d, msg, sizeof(msg), NULL, 0, false);
+}
+
+static int
+gt9886_write_reg(uint16_t reg, const uint8_t *data, unsigned len)
+{
+	/* Register pointer + payload as one write; the IC's data pointer
+	 * auto-increments within the message. */
+	uint8_t buf[2 + 784];
+	if (len > sizeof(buf) - 2u) {
+		return EIO;
+	}
+	buf[0] = (uint8_t)(reg >> 8);
+	buf[1] = (uint8_t)reg;
+	memcpy(buf + 2, data, len);
+	return touch_msg(0x5d, buf, 2u + len, NULL, 0, false);
+}
+
+static int
+gt9886_cmd(uint8_t op, uint8_t data)
+{
+	/* 3-byte command: {op, data, checksum} to 0x6f68 (vendor
+	 * goodix_cmds_init: cmds[2] = 0 - op - data). */
+	const uint8_t cmd[3] = {op, data, (uint8_t)(0u - op - data)};
+	return gt9886_write_reg(GT9886_CMD_REG, cmd, sizeof(cmd));
+}
+
+/*
+ * Vendor goodix_set_i2c_doze_mode(dev, false): write 0xAA to 0x30F0, then
+ * poll 0x3100 for 0xBB (rewrite 0xAA whenever it reads neither 0xAA nor
+ * 0xBB). Kept disabled afterwards: this driver polls on its own schedule,
+ * not from an interrupt the IC raises while awake.
+ */
+static int
+gt9886_doze_disable(void)
+{
+	static const uint8_t aa[1] = {0xaa};
+	for (unsigned i = 0; i < 10u; ++i) {
+		int err = gt9886_write_reg(NOR_DOZE_CTRL, aa, sizeof(aa));
+		if (err) {
+			return err;
+		}
+		touch_wait(1);
+		for (unsigned j = 0; j < 10u; ++j) {
+			uint8_t stat = 0;
+			err = touch_read(0x5d, NOR_DOZE_STAT, true, &stat, 1);
+			if (!err && stat == 0xbbu) {
+				return 0;
+			}
+			if (!err && stat != 0xaau) {
+				break; /* rewrite 0xAA and retry */
+			}
+			touch_wait(10);
+		}
+	}
+	return ETIMEDOUT;
+}
+
+static int
+gt9886_send_config(const uint8_t *cfg, unsigned len)
+{
+	uint8_t rdy = 0;
+	bool ok = false;
+	/* 1. command register free? */
+	for (unsigned i = 0; i < 10u; ++i) {
+		int err = touch_read(0x5d, GT9886_CMD_REG, true, &rdy, 1);
+		if (!err && rdy == GT9886_CMD_READY) {
+			ok = true;
+			break;
+		}
+		touch_wait(10);
+	}
+	if (!ok) {
+		printf("SWEET TOUCH: cfg send: cmd reg not ready (%#x)\n", rdy);
+		return EIO;
+	}
+	/* 2. START_SEND_CFG (0x80) */
+	int err = gt9886_cmd(GT9886_CMD_START, 0);
+	if (err) {
+		printf("SWEET TOUCH: cfg send: start cmd err=%d\n", err);
+		return err;
+	}
+	/* 3. wait for PREPARE_OK (0x82), resending on abnormal reads */
+	ok = false;
+	for (unsigned i = 0; i < 10u; ++i) {
+		uint8_t cmd_buf[3] = {0};
+		err = touch_read(0x5d, GT9886_CMD_REG, true, cmd_buf, 3);
+		if (!err && cmd_buf[0] == GT9886_CMD_PREPARE) {
+			ok = true;
+			break;
+		}
+		if (!err && cmd_buf[0] != GT9886_CMD_START) {
+			(void)gt9886_cmd(GT9886_CMD_START, 0);
+		}
+		touch_wait(10);
+	}
+	if (!ok) {
+		printf("SWEET TOUCH: cfg send: no 0x82 prepare\n");
+		return EIO;
+	}
+	/* 4. the 784-byte config itself */
+	err = gt9886_write_reg(GT9886_CFG_REG, cfg, len);
+	if (err) {
+		printf("SWEET TOUCH: cfg send: write %uB err=%d\n", len, err);
+		return err;
+	}
+	/* 5. END_SEND_CFG (0x83), then wait for the register to free */
+	err = gt9886_cmd(GT9886_CMD_END, 0);
+	if (err) {
+		printf("SWEET TOUCH: cfg send: end cmd err=%d\n", err);
+		return err;
+	}
+	ok = false;
+	for (unsigned i = 0; i < 10u; ++i) {
+		err = touch_read(0x5d, GT9886_CMD_REG, true, &rdy, 1);
+		if (!err && rdy == GT9886_CMD_READY) {
+			ok = true;
+			break;
+		}
+		touch_wait(10);
+	}
+	if (!ok) {
+		printf("SWEET TOUCH: cfg send: cmd reg stuck after send (%#x)\n", rdy);
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * Vendor goodix_set_i2c_doze_mode(false): request 0xaa, wait for 0xbb.
+ * Doze is never re-enabled: this driver polls instead of waiting for the
+ * IRQ, so the IC has to stay awake between reads. Superseded by the more
+ * robust gt9886_doze_disable() below; kept for reference/diagnosis.
+ */
+__attribute__((unused))
+static int
+touch_nor_doze_off(void)
+{
+	uint8_t v = 0;
+	int err = touch_nor_write(NOR_DOZE_CTRL, 0xaa);
+	touch_wait(1);
+	for (unsigned i = 0; i < 9u; ++i) {
+		err = touch_read(0x5d, NOR_DOZE_STAT, true, &v, 1);
+		if (!err && v == 0xbbu) {
+			return 0;
+		}
+		if (err || v != 0xaau) {
+			(void)touch_nor_write(NOR_DOZE_CTRL, 0xaa);
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: normandy doze-off not confirmed (stat=%#x err=%d)\n", v, err);
+	return err ? err : ETIMEDOUT;
+}
+
+/*
+ * Vendor goodix_read_version: the 72-byte version block sums to zero and
+ * holds PID "9886" at 0x4535, VID at 0x453d and the sensor ID at 0x4541.
+ * Returns 0 only when the checksum is zero AND the PID is "9886"; pid[4]
+ * and *sump carry the raw evidence for the retry-ladder verdict line.
+ */
+static int
+touch_nor_probe(uint8_t pid[4], uint8_t *sump)
+{
+	uint8_t v[NOR_VERSION_LEN];
+	uint8_t sum = 0;
+	memset(v, 0xa5, sizeof(v));
+	int err = touch_read(0x5d, NOR_VERSION_REG, true, v, sizeof(v));
+	if (!err) {
+		for (unsigned off = 0; off < sizeof(v); off += 16) {
+			char line[49];
+			unsigned len = sizeof(v) - off < 16u ? (unsigned)sizeof(v) - off : 16u;
+			line[0] = '\0';
+			for (unsigned j = 0; j < len; ++j) {
+				(void)snprintf(line + j * 3u, 4, "%02x ", v[off + j]);
+			}
+			printf("SWEET TOUCH: probe raw %#x: %s\n", NOR_VERSION_REG + off, line);
+		}
+		for (unsigned i = 0; i < sizeof(v); ++i) {
+			sum = (uint8_t)(sum + v[i]);
+		}
+	}
+	const uint8_t *vid = v + NOR_VID_OFF;
+	printf("SWEET TOUCH: normandy version err=%d sum=%#x pid=%02x%02x%02x%02x vid=%02x%02x%02x%02x sensor=%u\n",
+	    err, sum, v[NOR_PID_OFF], v[NOR_PID_OFF + 1u], v[NOR_PID_OFF + 2u],
+	    v[NOR_PID_OFF + 3u], vid[0], vid[1], vid[2], vid[3],
+	    v[NOR_SENSOR_OFF] & 15u);
+	pid[0] = v[NOR_PID_OFF];
+	pid[1] = v[NOR_PID_OFF + 1u];
+	pid[2] = v[NOR_PID_OFF + 2u];
+	pid[3] = v[NOR_PID_OFF + 3u];
+	*sump = sum;
+	if (err) {
+		return err;
+	}
+	if (sum || pid[0] != '9' || pid[1] != '8' || pid[2] != '8' || pid[3] != '6') {
+		return ENODEV;
+	}
+	st.sensor = v[NOR_SENSOR_OFF] & 15u;
+	return 0;
+}
+
+static int
+touch_goodix_nor(void)
+{
+	uint8_t buf[NOR_FIRST_LEN + (TOUCH_MAX - 1u) * GOODIX_POINT_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, NOR_EVENT_REG, true, buf, NOR_FIRST_LEN);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		err = EIO;
+	} else if (n > 1u) {
+		err = touch_read(0x5d, NOR_EVENT_REG + NOR_FIRST_LEN, true,
+		    buf + NOR_FIRST_LEN, (n - 1u) * GOODIX_POINT_LEN);
+	}
+	if (!err) {
+		err = touch_nor_parse(buf, n, st.flip, st.b->max_x, st.b->max_y, &mask, x, y);
+	}
+	/* Like the vendor handler, clear the status for every touch frame seen. */
+	int ack = touch_nor_write(NOR_EVENT_REG, 0);
+	if (!err) {
+		err = ack;
+	}
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
