+// Reserve [Start, Start + Length) one memory-map entry at a time. The DXE core refuses a single
+// AllocatePages that spans several free entries (ConvertPages: "covers multiple entries" ->
+// EFI_NOT_FOUND), and a run found by RunEnd() is exactly such a chain. The pieces are adjacent, so
+// the window is still physically contiguous; freeing it as one range is allowed.
+STATIC
+EFI_STATUS
+ReserveRange (EFI_MEMORY_DESCRIPTOR *Map, UINTN Size, UINTN Stride, UINT64 Start, UINT64 Length)
+{
+  EFI_MEMORY_DESCRIPTOR *Descriptor;
+  EFI_PHYSICAL_ADDRESS  Piece;
+  EFI_STATUS            Status;
+  UINTN                 Offset;
+  UINT64                Cursor;
+  UINT64                End;
+  UINT64                DescriptorEnd;
+  UINT64                PieceEnd;
+
+  Cursor = Start;
+  End = Start + Length;
+  while (Cursor < End) {
+    PieceEnd = 0;
+    for (Offset = 0; Offset + Stride <= Size; Offset += Stride) {
+      Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
+      DescriptorEnd = Descriptor->PhysicalStart + EFI_PAGES_TO_SIZE (Descriptor->NumberOfPages);
+      if ((Descriptor->Type == EfiConventionalMemory) && (Descriptor->PhysicalStart <= Cursor) &&
+          (Cursor < DescriptorEnd)) {
+        PieceEnd = MIN (DescriptorEnd, End);
+        break;
+      }
+    }
+    if (PieceEnd == 0) {
+      Status = EFI_NOT_FOUND;
+    } else {
+      Piece = Cursor;
+      Status = gBS->AllocatePages (AllocateAddress, EfiLoaderCode, EFI_SIZE_TO_PAGES (PieceEnd - Cursor), &Piece);
+    }
+    if (EFI_ERROR (Status)) {
+      if (Cursor > Start) { gBS->FreePages (Start, EFI_SIZE_TO_PAGES (Cursor - Start)); }
+      return Status;
+    }
+    Cursor = PieceEnd;
+  }
+  return EFI_SUCCESS;
+}
